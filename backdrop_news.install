/**
 * Create taxonomies for categorizing content.
 */
function _backdrop_news_create_taxonomies() {
  // إنشاء مفردات التصنيفات
  $categories = new TaxonomyVocabulary(array(
    'name' => st('التصنيفات'),
    'description' => st('تصنيفات الأخبار الرئيسية'),
    'machine_name' => 'categories',
  ));
  taxonomy_vocabulary_save($categories);

  // إضافة مصطلحات التصنيفات
  $category_terms = array(
    'السياسة' => 'أخبار سياسية ودولية',
    'الرياضة' => 'أخبار رياضية محلية وعالمية',
    'التكنولوجيا' => 'أخبار وتطورات تقنية',
    'الاقتصاد' => 'أخبار اقتصادية وأسواق',
    'الثقافة' => 'أخبار ثقافية وفنية',
    'الصحة' => 'أخبار صحية وطبية',
  );

  foreach ($category_terms as $name => $description) {
    $term = new TaxonomyTerm(array(
      'name' => st($name),
      'description' => st($description),
      'vocabulary' => $categories->machine_name,
    ));
    taxonomy_term_save($term);
  }

  // إنشاء حقل التصنيفات
  $field_categories = array(
    'field_name' => 'field_categories',
    'type' => 'taxonomy_term_reference',
    'cardinality' => 1,
    'settings' => array(
      'allowed_values' => array(
        array(
          'vocabulary' => 'categories',
          'parent' => 0,
        ),
      ),
    ),
  );
  field_create_field($field_categories);

  // إضافة حقل التصنيفات إلى المقالات
  $instance_categories = array(
    'field_name' => 'field_categories',
    'entity_type' => 'node',
    'label' => st('التصنيف'),
    'bundle' => 'article',
    'description' => st('اختر التصنيف الرئيسي للمقالة'),
    'required' => TRUE,
    'widget' => array(
      'type' => 'options_select',
      'weight' => 3,
    ),
    'display' => array(
      'default' => array(
        'label' => 'above',
        'type' => 'taxonomy_term_reference_link',
        'weight' => 3,
      ),
      'teaser' => array(
        'label' => 'above',
        'type' => 'taxonomy_term_reference_link',
        'weight' => 3,
      ),
    ),
  );
  field_create_instance($instance_categories);

  // إضافة حقل التصنيفات إلى أخبار الفيديو
  $instance_video_categories = array(
    'field_name' => 'field_categories',
    'entity_type' => 'node',
    'label' => st('التصنيف'),
    'bundle' => 'video_news',
    'description' => st('اختر التصنيف للخبر الفيديو'),
    'required' => TRUE,
    'widget' => array(
      'type' => 'options_select',
      'weight' => 3,
    ),
    'display' => array(
      'default' => array(
        'label' => 'above',
        'type' => 'taxonomy_term_reference_link',
        'weight' => 3,
      ),
    ),
  );
  field_create_instance($instance_video_categories);

  // إنشاء مفردات الوسوم
  $tags = new TaxonomyVocabulary(array(
    'name' => st('الوسوم'),
    'description' => st('وسوم عامة لتصنيف المقالات'),
    'machine_name' => 'tags',
  ));
  taxonomy_vocabulary_save($tags);

  // إضافة مصطلحات الوسوم
  $tag_terms = array(
    'عاجل' => 'أخبار عاجلة ومستجدة',
    'حصري' => 'أخبار حصرية',
    'تحليل' => 'تحليلات صحفية معمقة',
    'مقابلة' => 'مقابلات صحفية',
    'تقرير' => 'تقارير شاملة',
  );

  foreach ($tag_terms as $name => $description) {
    $term = new TaxonomyTerm(array(
      'name' => st($name),
      'description' => st($description),
      'vocabulary' => 'tags',
    ));
    taxonomy_term_save($term);
  }

  // إنشاء حقل الوسوم
  $field_tags = array(
    'field_name' => 'field_tags',
    'type' => 'taxonomy_term_reference',
    'cardinality' => FIELD_CARDINALITY_UNLIMITED,
    'settings' => array(
      'allowed_values' => array(
        array(
          'vocabulary' => 'tags',
          'parent' => 0,
        ),
      ),
    ),
  );
  field_create_field($field_tags);

  // إضافة حقل الوسوم إلى المقالات
  $instance_tags = array(
    'field_name' => 'field_tags',
    'entity_type' => 'node',
    'label' => st('الوسوم'),
    'bundle' => 'article',
    'description' => st('أضف وسوماً لتصنيف المقالة'),
    'required' => FALSE,
    'widget' => array(
      'type' => 'taxonomy_autocomplete',
      'weight' => 4,
    ),
    'display' => array(
      'default' => array(
        'label' => 'above',
        'type' => 'taxonomy_term_reference_link',
        'weight' => 4,
      ),
      'teaser' => array(
        'label' => 'above',
        'type' => 'taxonomy_term_reference_link',
        'weight' => 4,
      ),
    ),
  );
  field_create_instance($instance_tags);
}

/**
 * Setup user roles and permissions.
 */
function _backdrop_news_setup_roles_permissions() {
  // إنشاء دور الصحفي
  $journalist_role = new stdClass();
  $journalist_role->name = 'journalist';
  $journalist_role->label = 'صحفي';
  $journalist_role->description = 'يمكنه إنشاء وتحرير مقالاته الخاصة';
  $journalist_role->weight = 2;
  user_role_save($journalist_role);

  $journalist_permissions = array(
    'access content',
    'access comments',
    'post comments',
    'skip comment approval',
    'create article content',
    'edit own article content',
    'view own unpublished content',
    'upload editor images',
    'access site in maintenance mode',
    'access administration bar',
    'access content overview',
    'search content',
    'use advanced search',
    'access file overview',
    'create files',
    'view own files',
    'view files',
    'edit terms in tags',
  );
  user_role_grant_permissions('journalist', $journalist_permissions);

  // إنشاء دور المحرر
  $editor_role = new stdClass();
  $editor_role->name = 'editor';
  $editor_role->label = 'محرر';
  $editor_role->description = 'يمكنه إدارة كل المقالات والنشر';
  $editor_role->weight = 3;
  user_role_save($editor_role);

  $editor_permissions = array(
    'access content',
    'access comments',
    'post comments',
    'skip comment approval',
    'create article content',
    'edit own article content',
    'edit any article content',
    'delete own article content',
    'delete any article content',
    'create page content',
    'edit own page content',
    'edit any page content',
    'delete own page content',
    'delete any page content',
    'create video_news content',
    'edit own video_news content',
    'edit any video_news content',
    'delete own video_news content',
    'delete any video_news content',
    'view own unpublished content',
    'view any unpublished content',
    'upload editor images',
    'access dashboard',
    'view the administration theme',
    'access administration bar',
    'access content overview',
    'access administration pages',
    'access site in maintenance mode',
    'flush caches',
    'administer taxonomy',
    'edit terms in categories',
    'delete terms in categories',
    'edit terms in tags',
    'delete terms in tags',
    'administer nodes',
    'search content',
    'use advanced search',
    'access file overview',
    'create files',
    'view own files',
    'view files',
  );
  user_role_grant_permissions('editor', $editor_permissions);

  // إنشاء دور المسؤول
  $admin_role = new stdClass();
  $admin_role->name = 'administrator';
  $admin_role->label = 'مسؤول';
  $admin_role->description = 'له جميع الصلاحيات';
  $admin_role->weight = 4;
  $admin_role->permissions = array_keys(module_invoke_all('permission'));
  user_role_save($admin_role);
  config_set('system.core', 'user_admin_role', $admin_role->name);

  // تعيين دور المسؤول للمستخدم الأول
  $admin_user = user_load(1);
  $admin_user->roles[] = 'administrator';
  $admin_user->path['auto'] = TRUE;
  user_save($admin_user);

  // إعطاء صلاحيات للمستخدم العام
  $anonymous_permissions = array(
    'access content',
    'access comments',
  );
  user_role_grant_permissions(BACKDROP_ANONYMOUS_ROLE, $anonymous_permissions);

  $authenticated_permissions = array(
    'access content',
    'access comments',
    'post comments',
    'skip comment approval',
    'view own unpublished content',
    'search content',
    'use advanced search',
  );
  user_role_grant_permissions(BACKDROP_AUTHENTICATED_ROLE, $authenticated_permissions);
}

/**
 * Import default content for the news site.
 */
function _backdrop_news_import_default_content() {
  // الصفحة الرئيسية
  $home_page = entity_create('node', array(
    'title' => st('مرحباً بك في موقع الأخبار'),
    'type' => 'page',
    'status' => NODE_PUBLISHED,
    'promote' => 0,
    'sticky' => 0,
    'uid' => 1,
    'body' => array(
      LANGUAGE_NONE => array(
        array(
          'value' => '<p>' . st('أهلا وسهلا بك في موقع الأخبار الإخباري الشامل.') . '</p><p>' . st('نقدم لك أحدث الأخبار من حول العالم بشكل يومي ومستمر، مع تغطية شاملة للأحداث الهامة والمتطورات المستجدة.') . '</p><p>' . st('اختر التصنيف الذي يهمك من القائمة أعلاه وابقَ محدثاً مع آخر الأخبار والتطورات.') . '</p>',
          'format' => 'basic_html',
        ),
      ),
    ),
  ));
  $home_page->path = array('alias' => 'home', 'pathauto' => FALSE);
  $home_page->save();

  // صفحة من نحن
  $about_page = entity_create('node', array(
    'title' => st('من نحن'),
    'type' => 'page',
    'status' => NODE_PUBLISHED,
    'promote' => 0,
    'sticky' => 0,
    'uid' => 1,
    'body' => array(
      LANGUAGE_NONE => array(
        array(
          'value' => '<p>' . st('موقع الأخبار هو منصة إعلامية متخصصة في نقل الأخبار بمصداقية وموثوقية عالية.') . '</p><p>' . st('فريقنا المتخصص والمحترف يعمل بجد وكفاءة لتقديم أفضل الخدمات الإخبارية والتحليلات المعمقة.') . '</p><p>' . st('نؤمن بأهمية نشر المعلومات الدقيقة والموثوقة لجمهورنا الكريم وقرائنا الأوفياء.') . '</p>',
          'format' => 'basic_html',
        ),
      ),
    ),
  ));
  $about_page->path = array('alias' => 'about', 'pathauto' => FALSE);
  $about_page->save();

  // صفحة تواصل معنا
  $contact_page = entity_create('node', array(
    'title' => st('تواصل معنا'),
    'type' => 'page',
    'status' => NODE_PUBLISHED,
    'promote' => 0,
    'sticky' => 0,
    'uid' => 1,
    'body' => array(
      LANGUAGE_NONE => array(
        array(
          'value' => '<p>' . st('يمكنك التواصل معنا مباشرة من خلال البريد الإلكتروني أو نموذج الاتصال.') . '</p><p>' . st('كما يمكنك متابعتنا على جميع وسائل التواصل الاجتماعي للحصول على آخر الأخبار والتحديثات.') . '</p><p>' . st('نرحب بآرائك واقتراحاتك ونقدر تفاعلك ومساهمتك الغالية معنا.') . '</p>',
          'format' => 'basic_html',
        ),
      ),
    ),
  ));
  $contact_page->path = array('alias' => 'contact', 'pathauto' => FALSE);
  $contact_page->save();

  // مقالة عاجلة تجريبية
  $breaking_article = entity_create('node', array(
    'title' => st('خبر عاجل: تطورات جديدة في المجال التقني'),
    'type' => 'article',
    'status' => NODE_PUBLISHED,
    'promote' => 1,
    'sticky' => 1,
    'uid' => 1,
    'body' => array(
      LANGUAGE_NONE => array(
        array(
          'value' => '<p>' . st('شهد المجال التقني تطورات مهمة جداً في الفترة الأخيرة، وتعتبر هذه التطورات نقطة تحول في صناعة التكنولوجيا.') . '</p><p>' . st('جاءت هذه التطورات لتغيير مسار العديد من الشركات العملاقة وتأثيرها يمتد إلى جميع القطاعات والمجالات.') . '</p><p>' . st('يتوقع الخبراء أن تستمر هذه الموجة من التطور والابتكار في السنوات القادمة.') . '</p>',
          'format' => 'basic_html',
        ),
      ),
    ),
  ));
  $breaking_article->path = array('pathauto' => TRUE);
  $breaking_article->save();

  // مقالة اقتصادية
  $economy_article = entity_create('node', array(
    'title' => st('تقرير خاص: الاقتصاد العالمي في 2024'),
    'type' => 'article',
    'status' => NODE_PUBLISHED,
    'promote' => 1,
    'sticky' => 0,
    'uid' => 1,
    'body' => array(
      LANGUAGE_NONE => array(
        array(
          'value' => '<p>' . st('يتوقع الخبراء الاقتصاديون نمواً متوسطاً في الاقتصاد العالمي خلال هذا العام.') . '</p><p>' . st('هذا التقرير الشامل يشمل تحليلاً مفصلاً للأسواق الرئيسية والاتجاهات الاقتصادية العالمية.') . '</p><p>' . st('سيساعد هذا التقرير صناع القرار على فهم أفضل للمشهد الاقتصادي.') . '</p>',
          'format' => 'basic_html',
        ),
      ),
    ),
  ));
  $economy_article->path = array('pathauto' => TRUE);
  $economy_article->save();

  // مقالة رياضية
  $sports_article = entity_create('node', array(
    'title' => st('الرياضة: نتائج المباريات الأسبوعية'),
    'type' => 'article',
    'status' => NODE_PUBLISHED,
    'promote' => 0,
    'sticky' => 0,
    'uid' => 1,
    'body' => array(
      LANGUAGE_NONE => array(
        array(
          'value' => '<p>' . st('شهد الأسبوع الماضي عدة مباريات مثيرة ومليئة بالمفاجآت.') . '</p><p>' . st('حقق الفريق المحلي فوزاً مهماً على الضيوف في مباراة درامية.') . '</p><p>' . st('كانت الأداء الفني لجميع الفرق على مستوى عالي من الاحترافية والمهارة.') . '</p>',
          'format' => 'basic_html',
        ),
      ),
    ),
  ));
  $sports_article->path = array('pathauto' => TRUE);
  $sports_article->save();
}

/**
 * Setup system settings.
 */
function _backdrop_news_setup_system_settings() {
  // تعيين الصفحة الرئيسية
  config_set('system.core', 'site_frontpage', 'home');

  // تفعيل البحث
  config_set('search.settings', 'default_module', 'node');

  // إعدادات التعليقات
  config_set('comment.settings', 'preview', COMMENT_PREVIEW_OPTIONAL);
  config_set('comment.settings', 'form_location', COMMENT_FORM_BELOW);

  // إعدادات الأداء
  config_set('system.core', 'cache', 1);
  config_set('system.core', 'preprocess_css', 1);
  config_set('system.core', 'preprocess_js', 1);

  // تفعيل Admin Bar
  if (module_exists('admin_bar')) {
    module_enable(array('admin_bar'));
  }

  // تفعيل CKEditor إذا كان متاحاً
  if (module_exists('ckeditor')) {
    module_enable(array('ckeditor'));
  }

  // إنشاء قائمة رئيسية
  $main_menu_items = array(
    array(
      'link_title' => st('الرئيسية'),
      'link_path' => '<front>',
      'menu_name' => 'main-menu',
      'weight' => 0,
    ),
    array(
      'link_title' => st('من نحن'),
      'link_path' => 'about',
      'menu_name' => 'main-menu',
      'weight' => 1,
    ),
    array(
      'link_title' => st('تواصل معنا'),
      'link_path' => 'contact',
      'menu_name' => 'main-menu',
      'weight' => 2,
    ),
  );

  foreach ($main_menu_items as $item) {
    menu_link_save($item);
  }

  menu_rebuild();
}
