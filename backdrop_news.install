      'type' => 'article',
      'name' => st('مقالة إخبارية'),
      'description' => st('أضف مقالة إخبارية جديدة إلى الموقع'),
      'settings' => array(
        'status_default' => NODE_PUBLISHED,
        'promote_enabled' => TRUE,
        'promote_default' => FALSE,
        'sticky_enabled' => TRUE,
        'sticky_default' => FALSE,
        'node_preview' => TRUE,
        'revision_enabled' => TRUE,
        'revision_default' => FALSE,
        'show_submitted_info' => TRUE,
        'comment_enabled' => TRUE,
        'comment_default' => COMMENT_NODE_OPEN,
        'node_submitted' => TRUE,
        'node_user_picture' => TRUE,
        'menu_default' => TRUE,
        'menu_options' => array('main-menu'),
      ),
      'is_new' => TRUE,
    ),
    array(
      'type' => 'page',
      'name' => st('صفحة ثابتة'),
      'description' => st('صفحة ثابتة مثل من نحن أو تواصل معنا'),
      'settings' => array(
        'status_default' => NODE_PUBLISHED,
        'promote_enabled' => FALSE,
        'promote_default' => FALSE,
        'sticky_enabled' => FALSE,
        'sticky_default' => FALSE,
        'node_preview' => TRUE,
        'revision_enabled' => TRUE,
        'revision_default' => FALSE,
        'show_submitted_info' => FALSE,
        'comment_enabled' => FALSE,
        'comment_default' => COMMENT_NODE_CLOSED,
        'node_submitted' => FALSE,
        'node_user_picture' => FALSE,
        'menu_default' => TRUE,
        'menu_options' => array('main-menu'),
      ),
      'is_new' => TRUE,
    ),
    array(
      'type' => 'video_news',
      'name' => st('خبر فيديو'),
      'description' => st('أضف خبراً مع مقطع فيديو'),
      'settings' => array(
        'status_default' => NODE_PUBLISHED,
        'promote_enabled' => TRUE,
        'promote_default' => FALSE,
        'sticky_enabled' => TRUE,
        'sticky_default' => FALSE,
        'node_preview' => TRUE,
        'revision_enabled' => TRUE,
        'revision_default' => FALSE,
        'show_submitted_info' => TRUE,
        'comment_enabled' => TRUE,
        'comment_default' => COMMENT_NODE_OPEN,
        'node_submitted' => TRUE,
        'node_user_picture' => TRUE,
        'menu_default' => FALSE,
        'menu_options' => array(),
      ),
      'is_new' => TRUE,
    ),
  );

  foreach ($types as $type) {
    $type = (object) $type;
    node_type_save($type);
    node_add_body_field($type);
  }
}

