<?php
/**
 * @file
 * Install/uninstall and update functions for the news distribution profile.
 * ملف التثبيت الكامل لتوزيعة باك دروب الإخبارية
 * Professional News Distribution for Backdrop CMS
 */

/**
 * Implements hook_install().
 * Perform actions to set up the site for this profile.
 */
function backdrop_news_install() {
  // ================================
  // 1. إعداد صيغ النصوص
  // ================================
  _backdrop_news_setup_text_formats();

  // ================================
  // 2. تعيين الثيم الافتراضي
  // ================================
  _backdrop_news_setup_themes();

  // ================================
  // 3. إنشاء أنواع المحتوى
  // ================================
  _backdrop_news_create_content_types();

  // ================================
  // 4. إنشاء الحقول المخصصة
  // ================================
  _backdrop_news_create_fields();

  // ================================
  // 5. إنشاء التصنيفات والوسوم
  // ================================
  _backdrop_news_create_taxonomies();

  // ================================
  // 6. إنشاء الأدوار والصلاحيات
  // ================================
  _backdrop_news_setup_roles_permissions();

  // ================================
  // 7. استيراد المحتوى الافتراضي
  // ================================
  _backdrop_news_import_default_content();

  // ================================
  // 8. إعدادات النظام
  // ================================
  _backdrop_news_setup_system_settings();

  // ================================
  // 9. تنظيف الـ Cache
  // ================================
  backdrop_flush_all_caches();
}

/**
 * Setup text formats for the site.
 */
function _backdrop_news_setup_text_formats() {
  // تنسيق النص الأساسي
  $basic_format = array(
    'format' => 'basic_html',
    'name' => 'HTML أساسي',
    'weight' => 0,
    'editor' => 'ckeditor5',
    'editor_settings' => array(
      'image_upload' => array(
        'status' => 1,
        'dimensions' => array('max_width' => '', 'max_height' => ''),
        'max_size' => NULL,
        'scheme' => 'public',
        'directory' => 'inline-images',
      ),
    ),
    'filters' => array(
      'filter_url' => array(
        'weight' => 0,
        'status' => 1,
      ),
      'filter_html' => array(
        'weight' => 1,
        'status' => 1,
      ),
      'filter_autop' => array(
        'weight' => 2,
        'status' => 1,
      ),
      'filter_image_caption' => array(
        'weight' => 4,
        'status' => 1,
      ),
      'filter_image_align' => array(
        'weight' => 4,
        'status' => 1,
      ),
      'filter_htmlcorrector' => array(
        'weight' => 10,
        'status' => 1,
      ),
    ),
  );
  $basic_format = (object) $basic_format;
  filter_format_save($basic_format);

  // تنسيق Raw HTML
  $raw_html_format = array(
    'format' => 'raw_html',
    'name' => 'Raw HTML',
    'weight' => 1,
    'editor' => NULL,
    'filters' => array(
      'filter_url' => array(
        'weight' => 0,
        'status' => 1,
      ),
      'filter_autop' => array(
        'weight' => 1,
        'status' => 1,
      ),
      'filter_image_caption' => array(
        'weight' => 4,
        'status' => 1,
      ),
      'filter_image_align' => array(
        'weight' => 4,
        'status' => 1,
      ),
      'filter_htmlcorrector' => array(
        'weight' => 10,
        'status' => 1,
      ),
    ),
  );
  $raw_html_format = (object) $raw_html_format;
  filter_format_save($raw_html_format);
}

/**
 * Setup themes for the site.
 */
function _backdrop_news_setup_themes() {
  // تفعيل ثيم Basis
  $default_theme = 'basis';
  config_set('system.core', 'theme_default', $default_theme);
  theme_enable(array($default_theme));
  theme_disable(array('stark'));

  // تفعيل Admin Theme (Seven)
  db_update('system')
    ->fields(array('status' => 1))
    ->condition('type', 'theme')
    ->condition('name', 'seven')
    ->execute();
  config_set('system.core', 'admin_theme', 'seven');
  config_set('system.core', 'node_admin_theme', '1');
}

/**
 * Create content types for the news distribution.
